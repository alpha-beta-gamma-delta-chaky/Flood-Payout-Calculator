# Copy this file to .env on the server (cp .env.example .env) and edit it. .env is not committed.
#
# DOMAIN: the name Caddy serves, for example yourname.duckdns.org once it points at the server.
#         Caddy then gets an HTTPS certificate for it automatically.
#         Keep :80 on your own computer for plain HTTP at http://localhost.
DOMAIN=:80
